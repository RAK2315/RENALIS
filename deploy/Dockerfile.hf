FROM python:3.10-slim

WORKDIR /app

COPY requirements-lock.txt .
RUN pip install --no-cache-dir -r requirements-lock.txt

COPY backend/ ./backend/
COPY docs/ ./docs/
COPY output/ ./output/
COPY public/ ./public/
COPY data/ ./data/
RUN chown -R 1000:1000 /app

USER 1000
ENV HOME=/app

EXPOSE 7860
CMD ["uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "7860"]
